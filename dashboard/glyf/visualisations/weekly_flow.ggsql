SELECT week, 'opened' AS series, opened AS issues FROM {{ ref('weekly_flow') }}
UNION ALL
SELECT week, 'closed' AS series, closed AS issues FROM {{ ref('weekly_flow') }}
ORDER BY week, series DESC

VISUALISE week AS x, issues AS y, series AS color
DRAW bar
LABEL title => 'Opened vs closed per week'
LABEL subtitle => 'Complete weeks; when closed > opened the backlog shrank'
LABEL x_title => 'Week'
LABEL y_title => 'Issues'
INTERACT tooltip, legend_filter
