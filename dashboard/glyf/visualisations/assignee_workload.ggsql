SELECT assignee_login, issue_category, issue_count
FROM {{ ref('assignee_workload') }}
ORDER BY assignee_total DESC, assignee_login, CASE issue_category WHEN 'feature' THEN 1 WHEN 'bug' THEN 2 WHEN 'task' THEN 3 ELSE 4 END

VISUALISE assignee_login AS x, issue_count AS y, issue_category AS color
DRAW bar
LABEL title => 'Open issues by assignee'
LABEL subtitle => 'Top 15, including unassigned'
LABEL x_title => 'Assignee'
LABEL y_title => 'Open issues'
CONFIG width => 1100
INTERACT tooltip, legend_filter
