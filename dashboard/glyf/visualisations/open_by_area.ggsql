SELECT area, issue_category, issue_count
FROM {{ ref('open_by_area') }}
ORDER BY area_total DESC, area, CASE issue_category WHEN 'feature' THEN 1 WHEN 'bug' THEN 2 WHEN 'task' THEN 3 ELSE 4 END

VISUALISE area AS x, issue_count AS y, issue_category AS color
DRAW bar
LABEL title => 'Open issues by area'
LABEL subtitle => 'Issues with several areas count in each'
LABEL x_title => 'Area'
LABEL y_title => 'Open issues'
CONFIG width => 1100
INTERACT tooltip, legend_filter
