SELECT adapter, issue_category, issue_count
FROM {{ ref('open_by_adapter') }}
ORDER BY adapter_total DESC, adapter, CASE issue_category WHEN 'feature' THEN 1 WHEN 'bug' THEN 2 WHEN 'task' THEN 3 ELSE 4 END

VISUALISE adapter AS x, issue_count AS y, issue_category AS color
DRAW bar
LABEL title => 'Open issues by adapter'
LABEL subtitle => '(none) = adapter-agnostic'
LABEL x_title => 'Adapter'
LABEL y_title => 'Open issues'
CONFIG width => 1100
INTERACT tooltip, legend_filter
