SELECT week, issue_category, open_issues
FROM {{ ref('backlog_weekly') }}
ORDER BY week, CASE issue_category WHEN 'feature' THEN 1 WHEN 'bug' THEN 2 WHEN 'task' THEN 3 ELSE 4 END

VISUALISE week AS x, open_issues AS y, issue_category AS color
DRAW area
LABEL title => 'Open issues over time'
LABEL subtitle => 'Open at the end of each week, by type'
LABEL x_title => 'Week'
LABEL y_title => 'Open issues'
INTERACT tooltip, legend_filter
